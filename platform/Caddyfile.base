{
    # Admin API enabled on default port 2019 for reload commands
}

http://localhost {
    handle /api/manifests/* {
        root * /srv/registry
        rewrite * /games.json
        file_server
    }

    handle /api/registry.json {
        root * /srv/registry
        rewrite * /games.json
        file_server
    }

    handle /api/v1/* {
        reverse_proxy portal-backend:3000
    }

    handle {
        root * /srv/portal
        try_files {path} /index.html
        file_server
    }
}
